{
  "name": "townpass-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && pnpm build-only",
    "build-only": "vite build && vite build -c vite.overlay.config.ts && node scripts/copy-overlay.mjs",
    "build-overlay": "vite build -c vite.overlay.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "fetch-embed-model": "node scripts/fetch-embed-model.mjs",
    "precompute": "node scripts/precompute-embeddings.mjs",
    "eval": "tsx ../eval/eval.ts",
    "matrix": "tsx ../eval/matrix.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.4.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@types/node": "^20.12.5",
    "tsx": "^4.19.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.0.11"
  }
}

{
  "id": "guide_parking_fee",
  "title": {
    "zh": "繳停車費"
  },
  "entry": "/fee-payment/detail/fee-5",
  "match": {
    "url": "^/fee-payment/detail/fee-5"
  },
  "steps": [
    {
      "id": "vehicle",
      "url": "^/fee-payment/detail/fee-5",
      "find": [
        {
          "label": "汽車"
        },
        {
          "text": "汽車",
          "exact": true
        }
      ],
      "say": {
        "zh": "先點「汽車」或「機車」"
      },
      "more": {
        "zh": "選了車種才會出現車牌欄位"
      },
      "done_when": "click",
      "skip_if_missing": true,
      "skip_if_visible": [
        {
          "css": "input:not(#payment_number):not([type=radio]):not([type=checkbox])"
        }
      ]
    },
    {
      "id": "fill",
      "url": "^/fee-payment/detail/fee-5",
      "find": [
        {
          "label": "車牌號碼"
        },
        {
          "css": "input:not(#payment_number):not([type=radio]):not([type=checkbox])"
        }
      ],
      "say": {
        "zh": "輸入車牌號碼"
      },
      "done_when": "input",
      "more": {
        "zh": "輸入車牌，例如 ABC1234；也可以切到「繳費編號」分頁"
      },
      "accept": "text"
    },
    {
      "id": "search",
      "url": "^/fee-payment/detail/fee-5",
      "find": [
        {
          "role": "button",
          "text": "查詢"
        }
      ],
      "say": {
        "zh": "按「查詢」"
      },
      "done_when": "route",
      "more": {
        "zh": "最下面藍色的大按鈕"
      }
    },
    {
      "id": "select_all",
      "url": "^/fee-payment/result/",
      "find": [
        {
          "text": "全部繳清",
          "exact": true
        }
      ],
      "say": {
        "zh": "點「全部繳清」"
      },
      "done_when": "click",
      "more": {
        "zh": "會把所有帳單都勾起來"
      },
      "skip_if_missing": true
    },
    {
      "id": "go_pay",
      "url": "^/fee-payment/result/",
      "find": [
        {
          "role": "button",
          "text": "前往繳費"
        }
      ],
      "say": {
        "zh": "按「前往繳費」"
      },
      "done_when": "route",
      "more": {
        "zh": "最下面藍色的大按鈕"
      },
      "confirm": true
    },
    {
      "id": "choose_way",
      "url": "^/fee-payment/payment/",
      "find": [
        {
          "text": "台北富邦信用卡",
          "role": "button"
        },
        {
          "text": "悠遊付",
          "role": "button"
        },
        {
          "css": "button.rounded-md"
        }
      ],
      "say": {
        "zh": "點一種付款方式"
      },
      "done_when": "click",
      "more": {
        "zh": "信用卡或行動支付都可以，點了畫面會再問你一次"
      }
    },
    {
      "id": "confirm_pay",
      "url": "^/fee-payment/payment/",
      "find": [
        {
          "text": "是",
          "role": "button",
          "exact": true
        },
        {
          "text": "確認",
          "role": "button",
          "exact": true
        }
      ],
      "say": {
        "zh": "按「是」"
      },
      "more": {
        "zh": "這一步才會真的送出付款"
      },
      "done_when": "click",
      "confirm": true,
      "final": true
    }
  ],
  "finish": "quiet"
}
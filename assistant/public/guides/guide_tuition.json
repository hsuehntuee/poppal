{
  "id": "guide_tuition",
  "title": {
    "zh": "繳學雜費"
  },
  "entry": "/fee-payment/detail/fee-7",
  "match": {
    "url": "^/fee-payment/detail/fee-7"
  },
  "steps": [
    {
      "id": "fill",
      "url": "^/fee-payment/detail/fee-7",
      "find": [
        {
          "label": "繳費編號"
        },
        {
          "css": "input"
        }
      ],
      "say": {
        "zh": "輸入繳費編號"
      },
      "done_when": "input",
      "more": {
        "zh": "學校繳費單上的繳費編號"
      },
      "accept": "digits"
    },
    {
      "id": "search",
      "url": "^/fee-payment/detail/fee-7",
      "find": [
        {
          "role": "button",
          "text": "查詢"
        }
      ],
      "say": {
        "zh": "按「查詢」"
      },
      "done_when": "route",
      "more": {
        "zh": "最下面藍色的大按鈕"
      }
    },
    {
      "id": "select_all",
      "url": "^/fee-payment/result/",
      "find": [
        {
          "css": "label:has(input[type=checkbox]), a.underline"
        },
        {
          "text": "全部繳清",
          "exact": true
        }
      ],
      "say": {
        "zh": "勾要繳的帳單，或點「全部繳清」"
      },
      "done_when": "click",
      "more": {
        "zh": "可以只勾其中幾張"
      },
      "skip_if_missing": true,
      "pick_any": true,
      "skip_if_visible": [
        {
          "css": "label input[type=checkbox]:checked"
        }
      ]
    },
    {
      "id": "go_pay",
      "url": "^/fee-payment/result/",
      "find": [
        {
          "role": "button",
          "text": "前往繳費"
        }
      ],
      "say": {
        "zh": "按「前往繳費」"
      },
      "done_when": "route",
      "more": {
        "zh": "最下面藍色的大按鈕"
      },
      "confirm": true
    },
    {
      "id": "choose_way",
      "url": "^/fee-payment/payment/",
      "find": [
        {
          "css": "button.rounded-md"
        },
        {
          "text": "台北富邦信用卡",
          "role": "button"
        },
        {
          "text": "悠遊付",
          "role": "button"
        }
      ],
      "say": {
        "zh": "點一種付款方式"
      },
      "done_when": "click",
      "more": {
        "zh": "信用卡或行動支付都可以，點了畫面會再問你一次"
      },
      "pick_any": true
    },
    {
      "id": "confirm_pay",
      "url": "^/fee-payment/payment/",
      "find": [
        {
          "text": "是",
          "role": "button",
          "exact": true
        },
        {
          "text": "確認",
          "role": "button",
          "exact": true
        }
      ],
      "say": {
        "zh": "按「是」"
      },
      "more": {
        "zh": "這一步才會真的送出付款"
      },
      "done_when": "click",
      "confirm": true,
      "final": true
    }
  ],
  "finish": "quiet"
}
{
  "id": "guide_survey",
  "title": {
    "zh": "意見調查"
  },
  "entry": "/survey",
  "match": {
    "url": "^/survey"
  },
  "steps": [
    {
      "id": "pick",
      "url": "^/survey/?$",
      "find": [
        {
          "text": "{{entity}}"
        },
        {
          "css": "a[href*=\"survey/\"]"
        }
      ],
      "say": {
        "zh": "點一份問卷"
      },
      "done_when": "route",
      "say_default": "點一份問卷"
    },
    {
      "id": "answer",
      "url": "^/survey/",
      "find": [],
      "say": {
        "zh": "一題一題答"
      },
      "done_when": "manual",
      "walk_form": true
    },
    {
      "id": "submit",
      "url": "^/survey/",
      "find": [
        {
          "role": "button",
          "text": "送出"
        }
      ],
      "say": {
        "zh": "按「送出」"
      },
      "done_when": "click",
      "confirm": true,
      "final": true
    }
  ],
  "finish": "quiet"
}
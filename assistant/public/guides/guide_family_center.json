{
  "id": "guide_family_center",
  "title": {
    "zh": "親子館"
  },
  "entry": "/family-center",
  "match": {
    "url": "^/family-center"
  },
  "steps": [
    {
      "id": "pick",
      "url": "^/family-center/?$",
      "find": [
        {
          "text": "{{entity}}"
        },
        {
          "css": "a[href*=\"family-center/\"]"
        }
      ],
      "say": {
        "zh": "點你要去的親子館"
      },
      "done_when": "route",
      "say_default": "點你要去的親子館"
    },
    {
      "id": "activity",
      "url": "^/family-center/",
      "find": [
        {
          "role": "button",
          "text": "報名"
        }
      ],
      "say": {
        "zh": "點活動的「報名」"
      },
      "done_when": "click"
    },
    {
      "id": "form",
      "url": "^/family-center/",
      "find": [],
      "say": {
        "zh": "照畫面填"
      },
      "done_when": "manual",
      "walk_form": true
    },
    {
      "id": "submit",
      "url": "^/family-center/",
      "find": [
        {
          "role": "button",
          "text": "送出報名"
        }
      ],
      "say": {
        "zh": "按「送出報名」"
      },
      "done_when": "click",
      "confirm": true,
      "final": true
    }
  ],
  "finish": "quiet"
}
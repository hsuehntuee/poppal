{
  "id": "guide_find_place",
  "title": {
    "zh": "找地點"
  },
  "entry": "/surrounding-service",
  "match": {
    "url": "^/surrounding-service"
  },
  "steps": [
    {
      "id": "pick",
      "url": "^/surrounding-service",
      "find": [
        {
          "option": "{{entity}}"
        },
        {
          "css": "#findPlace"
        },
        {
          "css": "select"
        }
      ],
      "say": {
        "zh": "點開「請選擇要找的服務地圖」"
      },
      "say_default": {
        "zh": "點開「請選擇要找的服務地圖」"
      },
      "more": {
        "zh": "清單會展開，再點有「{{entity}}」的那一類"
      },
      "done_when": "change",
      "skip_if_visible": [
        {
          "text": "{{group}}",
          "role": "button"
        },
        {
          "css": ".leaflet-marker-icon"
        }
      ]
    },
    {
      "id": "group",
      "url": "^/surrounding-service",
      "find": [
        {
          "text": "{{group}}",
          "role": "button"
        }
      ],
      "say": {
        "zh": "點「{{group}}」"
      },
      "say_default": {
        "zh": "點有「{{entity}}」的那一類"
      },
      "more": {
        "zh": "展開後就會看到「{{entity}}」"
      },
      "done_when": "click",
      "skip_if_missing": true,
      "skip_if_visible": [
        {
          "text": "{{entity}}",
          "exact": true
        },
        {
          "css": ".leaflet-marker-icon"
        }
      ]
    },
    {
      "id": "item",
      "url": "^/surrounding-service",
      "find": [
        {
          "text": "{{entity}}",
          "exact": true
        }
      ],
      "say": {
        "zh": "點「{{entity}}」"
      },
      "say_default": {
        "zh": "點你要找的項目"
      },
      "done_when": "click",
      "skip_if_missing": true,
      "skip_if_visible": [
        {
          "css": ".leaflet-marker-icon"
        }
      ]
    },
    {
      "id": "look",
      "url": "^/surrounding-service",
      "find": [
        {
          "css": ".leaflet-marker-icon"
        },
        {
          "text": "公里"
        }
      ],
      "say": {
        "zh": "點地圖上的標記看地址"
      },
      "more": {
        "zh": "也可以按「展開列表」看清單"
      },
      "done_when": "manual",
      "final": true
    }
  ]
}
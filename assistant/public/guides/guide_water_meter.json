{
 "id": "guide_water_meter",
 "title": {
  "zh": "報水表度數"
 },
 "entry": "/water-service",
 "match": {
  "url": "^/water-service"
 },
 "steps": [
  {
   "id": "number",
   "url": "^/water-service",
   "find": [
    {
     "label": "水號"
    },
    {
     "css": "#water_number"
    }
   ],
   "say": {
    "zh": "輸入水號"
   },
   "done_when": "input",
   "more": {
    "zh": "帳單右上角的 10 位數字"
   },
   "accept": "digits",
   "min_len": 10,
   "max_len": 10
  },
  {
   "id": "value",
   "url": "^/water-service",
   "find": [
    {
     "label": "本期度數"
    },
    {
     "css": "#meter_value"
    }
   ],
   "say": {
    "zh": "輸入水表上的度數"
   },
   "done_when": "input",
   "more": {
    "zh": "水表黑色數字那幾位"
   },
   "accept": "digits",
   "min_len": 1,
   "max_len": 8
  },
  {
   "id": "submit",
   "url": "^/water-service",
   "find": [
    {
     "role": "button",
     "text": "送出"
    }
   ],
   "say": {
    "zh": "按「送出」"
   },
   "done_when": "click",
   "confirm": true,
   "final": true
  }
 ]
}
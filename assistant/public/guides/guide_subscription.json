{
  "id": "guide_subscription",
  "title": {
    "zh": "訂閱通知"
  },
  "entry": "/subscription",
  "match": {
    "url": "^/subscription"
  },
  "steps": [
    {
      "id": "open",
      "url": "^/subscription",
      "find": [
        {
          "text": "{{entity}}",
          "exact": true
        }
      ],
      "say": {
        "zh": "點「{{entity}}」"
      },
      "say_default": {
        "zh": "點你要訂閱的項目"
      },
      "more": {
        "zh": "點了會展開說明和「訂閱」鈕"
      },
      "done_when": "click",
      "skip_if_missing": true,
      "skip_if_visible": [
        {
          "text": "訂閱",
          "role": "button",
          "exact": true,
          "within": "{{entity}}"
        },
        {
          "text": "取消訂閱",
          "role": "button",
          "exact": true,
          "within": "{{entity}}"
        }
      ]
    },
    {
      "id": "subscribe",
      "url": "^/subscription",
      "find": [
        {
          "text": "訂閱",
          "role": "button",
          "exact": true,
          "within": "{{entity}}"
        },
        {
          "text": "訂閱",
          "role": "button",
          "exact": true
        }
      ],
      "say": {
        "zh": "按「訂閱」"
      },
      "done_when": "click",
      "final": true,
      "skip_if_visible": [
        {
          "within": "{{entity}}",
          "text": "取消訂閱",
          "exact": true
        }
      ]
    }
  ],
  "collapse": false,
  "finish": "quiet"
}
{
  "id": "guide_hospital_registration",
  "title": {
    "zh": "聯醫掛號"
  },
  "entry": "/hospital-registration",
  "match": {
    "url": "^/hospital-registration"
  },
  "steps": [
    {
      "id": "branch",
      "url": "^/hospital-registration",
      "find": [
        {
          "option": "{{entity}}"
        },
        {
          "css": "#branch"
        }
      ],
      "say": {
        "zh": "選院區"
      },
      "done_when": "change"
    },
    {
      "id": "dept",
      "url": "^/hospital-registration",
      "find": [
        {
          "css": "#dept"
        }
      ],
      "say": {
        "zh": "選科別"
      },
      "done_when": "change"
    },
    {
      "id": "slot",
      "url": "^/hospital-registration",
      "find": [
        {
          "css": "button[class*='slot'], .slot button"
        },
        {
          "text": "醫師",
          "role": "button"
        }
      ],
      "say": {
        "zh": "點一個時段"
      },
      "done_when": "click",
      "more": {
        "zh": "每位醫師下面的時間都可以選"
      },
      "pick_any": true
    },
    {
      "id": "submit",
      "url": "^/hospital-registration",
      "find": [
        {
          "role": "button",
          "text": "確認掛號"
        }
      ],
      "say": {
        "zh": "按「確認掛號」"
      },
      "done_when": "click",
      "confirm": true,
      "final": true
    }
  ],
  "finish": "quiet"
}
{
  "id": "guide_apply",
  "title": {
    "zh": "申辦服務"
  },
  "entry": "/",
  "match": {
    "url": "^/(form/)?$"
  },
  "steps": [
    {
      "id": "pick",
      "url": "^/$",
      "find": [
        {
          "text": "{{entity}}"
        },
        {
          "css": "input[placeholder*=\"問題\"]"
        }
      ],
      "say": {
        "zh": "點「{{entity}}」"
      },
      "done_when": "route",
      "say_default": {
        "zh": "在搜尋框輸入要申辦的項目"
      },
      "more": {
        "zh": "或在搜尋框輸入要申辦的項目"
      }
    },
    {
      "id": "form",
      "url": "^/form/",
      "find": [],
      "say": {
        "zh": "照畫面填資料"
      },
      "done_when": "manual",
      "more": {
        "zh": "填完按最下面的「下一步」"
      },
      "walk_form": true
    },
    {
      "id": "next",
      "url": "^/form/",
      "find": [
        {
          "role": "button",
          "text": "下一步",
          "exact": true
        }
      ],
      "say": {
        "zh": "按「下一步」"
      },
      "done_when": "click",
      "confirm": false
    },
    {
      "id": "form2",
      "url": "^/form/",
      "find": [],
      "say": {
        "zh": "照畫面填"
      },
      "done_when": "manual",
      "walk_form": true
    },
    {
      "id": "submit",
      "url": "^/form/",
      "find": [
        {
          "role": "button",
          "text": "送出",
          "exact": true
        }
      ],
      "say": {
        "zh": "確認沒問題就按「送出」"
      },
      "done_when": "click",
      "confirm": false,
      "final": true
    }
  ],
  "finish": "quiet"
}